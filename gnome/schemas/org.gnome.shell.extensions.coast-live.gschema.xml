<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.coast-live" path="/org/gnome/shell/extensions/coast-live/">
    <key name="manual-location" type="b">
      <default>false</default>
      <summary>Use custom coordinates</summary>
    </key>
    <key name="latitude" type="d">
      <range min="-90.0" max="90.0"/>
      <default>0.0</default>
      <summary>Custom latitude</summary>
    </key>
    <key name="longitude" type="d">
      <range min="-180.0" max="180.0"/>
      <default>0.0</default>
      <summary>Custom longitude</summary>
    </key>
    <key name="time-mode" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="fixed"/>
      </choices>
      <default>'auto'</default>
      <summary>Time of day: follow the sun, or show a chosen time</summary>
    </key>
    <key name="fixed-minutes" type="i">
      <range min="0" max="1439"/>
      <default>720</default>
      <summary>The chosen time of day, in minutes after midnight</summary>
    </key>
    <key name="weather-mode" type="s">
      <choices>
        <choice value="off"/>
        <choice value="live"/>
        <choice value="clear"/>
        <choice value="cloudy"/>
        <choice value="fog"/>
        <choice value="drizzle"/>
        <choice value="rain"/>
        <choice value="storm"/>
        <choice value="snow"/>
      </choices>
      <default>'off'</default>
      <summary>Weather shown over the scene: off, the real weather, or a fixed one</summary>
    </key>
    <key name="match-gnome-background" type="b">
      <default>true</default>
      <summary>Show a Coast Live still in GNOME Appearance and Activities</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="coast"/>
        <choice value="dunes"/>
        <choice value="plateau"/>
        <choice value="oasis"/>
        <choice value="amman"/>
      </choices>
      <default>'coast'</default>
      <summary>Live wallpaper scene</summary>
    </key>
    <key name="animation-speed" type="s">
      <choices>
        <choice value="economy"/>
        <choice value="balanced"/>
        <choice value="smooth"/>
        <choice value="ultra"/>
      </choices>
      <default>'balanced'</default>
      <summary>Animation frame rate</summary>
    </key>
  </schema>
</schemalist>
